# Sao chép thành .env rồi điền. KHÔNG commit file .env.

# Tên miền đã trỏ A record về IP của VPS (vd: notes.example.com)
DOMAIN=notes.example.com

# Mật khẩu Postgres (chỉ dùng chữ-số để tránh ký tự đặc biệt trong URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# Bí mật ký phiên đăng nhập (>= 32 ký tự): openssl rand -hex 32
JWT_SECRET=

# true: ai cũng đăng ký được | false: đóng đăng ký (sau khi bạn tạo xong tài khoản cần thiết)
ALLOW_REGISTRATION=true

# --- Thêm task bằng AI ---
# auto: có ANTHROPIC_API_KEY thì dùng Anthropic, không thì tắt (production không có Ollama) | anthropic | ollama | none
AI_PROVIDER=auto
# Hạn mức lượt AI mỗi người mỗi ngày (chống tốn tiền)
AI_DAILY_LIMIT=20
ANTHROPIC_API_KEY=
# Rẻ hơn nhiều cho việc tách task: claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5
